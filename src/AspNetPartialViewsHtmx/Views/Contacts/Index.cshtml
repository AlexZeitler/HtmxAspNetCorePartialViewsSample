@model IReadOnlyCollection<ContactViewModel>

@{
  ViewBag.Title = "Contacts";
  Layout = "_Layout";
}

@section Details {
  <li>
    
  @await RenderSectionAsync("Archive")
  </li>
}

@section Archive {
  <div>archive</div>
}


<h2>Contacts</h2>
<div class="w-80">
  <div class="mt-6 flow-root">
    <ul class="-my-5 divide-y divide-gray-200"
        role="list">
      @foreach (var contact in Model)
      {
        @await RenderSectionAsync("Details")
      }
    </ul>
  </div>
</div>
